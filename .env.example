# YourAppSpace instance URL (SaaS or local Docker/on-premise)
MCP_ENTITY_BASE_URL=https://core.yourappspace.com

# Recommended: Full user API key with the ip_api_key_ prefix (without Bearer)
MCP_ENTITY_API_KEY=ip_api_key_your_key_here

# Optional fallback (used only if MCP_ENTITY_API_KEY is omitted or blank)
# MCP_ENTITY_USER=your_email@example.com
# MCP_ENTITY_PASSWORD=your_password
